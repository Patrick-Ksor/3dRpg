/* ═══════════════════════════════════════════════════════════════════════
   Battle UI — dungeon theme: dark stone, iron borders, torch-orange accents.
   All colours live in the variables below; change them here only.
   Layout uses margins (not gap) so it works on every UI Toolkit version.
   ═══════════════════════════════════════════════════════════════════════ */

:root {
    --stone-0: rgb(14, 12, 12);
    --stone-1: rgb(22, 17, 14);
    --stone-2: rgb(36, 29, 23);
    --stone-3: rgb(54, 43, 32);
    --iron: rgb(92, 74, 54);
    --iron-dark: rgb(58, 46, 34);
    --iron-light: rgb(120, 98, 70);
    --line: rgb(74, 59, 44);

    --torch: rgb(224, 178, 86);
    --torch-dim: rgb(150, 115, 52);
    --parchment: rgb(238, 228, 208);
    --muted: rgb(166, 154, 138);

    --hp: rgb(190, 48, 48);
    --mp: rgb(70, 110, 215);
    --gold: rgb(242, 192, 72);
    --good: rgb(110, 200, 120);
    --bad: rgb(230, 90, 80);

    --violet: rgb(160, 100, 220);
    --curse: rgb(120, 170, 80);
}

.battle-root {
    -unity-font-definition: url("/Assets/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--parchment);
}

/* ── Shared building blocks ─────────────────────────────────────────────── */

.anim-hidden {
    opacity: 0;
    translate: 0 26px;
}

.menu-button {
    min-width: 120px;
    height: 36px;
    margin: 3px;
    padding: 0 14px;
    color: var(--parchment);
    -unity-font-style: bold;
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--line);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: var(--stone-3);
    border-color: var(--torch);
    scale: 1.04 1.04;
}

.menu-button:active {
    background-color: var(--stone-1);
    scale: 0.98 0.98;
}

.menu-button:disabled {
    opacity: 0.4;
}

/* ── Icons (set from USS so they also work in builds) ───────────────────── */

.icon-sword   { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Sword.png"); }
.icon-shield  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Shield.png"); }
.icon-energy  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Energy.png"); }
.icon-clover  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Clover.png"); }
.icon-coin    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png"); }
.icon-star    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Star.png"); }
.icon-heart   { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Heart.png"); }
.icon-heart-dark { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Heart Dark.png"); }
.icon-bomb    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Bomb.png"); }
.icon-book    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Book.png"); }
.icon-hammer  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Hammer.png"); }
.icon-potion  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Potion Green.png"); }
.icon-gem     { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Gem 1 Purple.png"); }
.icon-skull   { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Dark Gem.png"); }
.icon-attack  { background-image: url("/Assets/UI/AttackButton.png"); }
.icon-special { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Energy.png"); }
.icon-defend  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/shield blue.png"); }
.icon-item    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Bag.png"); }

/* ── Turn order (top centre) ────────────────────────────────────────────── */

.turn-order-wrap {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-order-panel {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 2px;
    border-color: var(--line);
}

.turn-order-title {
    margin-right: 12px;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--muted);
}

.turn-order {
    flex-direction: row;
    align-items: center;
}

.turn-chip {
    width: 40px;
    height: 40px;
    margin: 0 3px;
    background-color: var(--stone-1);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 2px;
    border-color: var(--iron-dark);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0.85;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.2s;
}

.turn-chip--player { border-color: rgb(78, 120, 190); }
.turn-chip--enemy  { border-color: rgb(150, 64, 58); }

.turn-chip--active {
    scale: 1.2 1.2;
    opacity: 1;
    margin: 0 7px;
    border-color: var(--torch);
    background-color: rgb(60, 46, 24);
}

.turn-chip--dead {
    opacity: 0.18;
}

.turn-chip-letter {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    color: var(--parchment);
    font-size: 16px;
    -unity-font-style: bold;
}

.turn-chip-hp {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background-color: rgba(0, 0, 0, 0.7);
}

.turn-chip-hp-fill {
    height: 100%;
    background-color: var(--hp);
}

.turn-divider {
    width: 2px;
    height: 30px;
    margin: 0 8px;
    background-color: var(--iron);
}

/* ── Run HUD (top left) ─────────────────────────────────────────────────── */

.run-hud {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 8px 12px;
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 2px;
    border-color: var(--line);
}

.run-hud-title {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 18px;
}

.run-hud-row {
    flex-direction: row;
    align-items: center;
}

.run-hud-label {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.gold-label {
    color: var(--gold);
    transition-property: scale, color;
    transition-duration: 0.18s;
    transform-origin: left center;
}

.gold-label--pulse {
    scale: 1.3 1.3;
    color: rgb(255, 230, 140);
}

.gold-icon {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.room-badge {
    display: none;
    margin-left: 8px;
    padding: 1px 7px;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 3px;
    color: var(--stone-0);
}

.room-badge--mini {
    display: flex;
    background-color: var(--torch);
}

.room-badge--boss {
    display: flex;
    background-color: var(--bad);
    color: rgb(255, 240, 230);
}

/* ── Relic / upgrade strip ──────────────────────────────────────────────── */

.run-rewards {
    position: absolute;
    top: 82px;
    left: 10px;
    max-width: 260px;
    max-height: 26%;
    flex-direction: row;
    flex-wrap: wrap;
    overflow: hidden;
}

.reward-pill {
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--parchment);
    background-color: rgba(27, 23, 26, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--iron);
}

.reward-pill--stat   { border-color: rgb(90, 150, 210); }
.reward-pill--attack { border-color: var(--torch); }
.reward-pill--trait  { border-color: var(--violet); }
.reward-pill--relic  { border-color: var(--gold); color: var(--gold); }

/* ── Hero card (bottom left) ────────────────────────────────────────────── */

.stats-panel-left {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 300px;
    padding: 10px 12px;
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 2px;
    border-color: var(--line);
}

.stats-panel-head {
    flex-direction: row;
    align-items: center;
}

.stats-panel-portrait {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: var(--stone-1);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 2px;
    border-color: var(--iron);
}

.stats-panel-info {
    flex-grow: 1;
}

.stats-panel-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    margin-bottom: 4px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--parchment);
}

.stats-panel-hp,
.stats-panel-mp {
    height: 15px;
    margin-bottom: 3px;
}

.stats-panel-hp .unity-progress-bar__container,
.stats-panel-mp .unity-progress-bar__container {
    height: 100%;
}

.stats-panel-hp .unity-progress-bar__background,
.stats-panel-mp .unity-progress-bar__background {
    background-color: rgb(30, 24, 20);
    border-width: 0;
}

.stats-panel-hp .unity-progress-bar__progress { background-color: rgb(78, 168, 96); }
.stats-panel-mp .unity-progress-bar__progress { background-color: var(--mp); }

.stats-panel-hp .unity-progress-bar__title,
.stats-panel-mp .unity-progress-bar__title {
    font-size: 13px;
    color: var(--parchment);
}

.stats-panel-rows {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.stats-panel-row {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 2px 0;
    padding: 1px 6px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.35s;
}

.stats-panel-row-icon {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.stats-panel-row-label {
    margin-right: 4px;
    font-size: 13px;
    color: var(--muted);
}

.stats-panel-row-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.stats-panel-row--up   { background-color: rgba(110, 200, 120, 0.45); }
.stats-panel-row--down { background-color: rgba(230, 90, 80, 0.45); }

/* ── Battle log (bottom centre) ─────────────────────────────────────────── */

.battle-log {
    position: absolute;
    left: 322px;
    right: 272px;
    bottom: 10px;
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 2px;
    border-color: var(--line);
}

.battle-log-header {
    padding: 6px 12px 2px 12px;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--muted);
}

.battle-log-header:hover {
    color: var(--torch);
}

.battle-log-scroll {
    height: 92px;
}

.battle-log-scroll .unity-scroller--vertical {
    width: 6px;
    margin-right: 2px;
}

.battle-log-scroll .unity-base-slider__drag-container {
    margin: 0;
}

.battle-log-scroll .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.battle-log-scroll .unity-base-slider__dragger {
    width: 4px;
    background-color: var(--iron);
    border-width: 0;
    border-radius: 2px;
}

.battle-log-scroll .unity-repeat-button {
    display: none;
}

.battle-log-content {
    padding: 2px 12px 6px 12px;
}

.battle-log-entry {
    margin-bottom: 2px;
    font-size: 16px;
    white-space: normal;
    color: var(--parchment);
}

.log-crit   { color: var(--torch); -unity-font-style: bold; }
.log-heal   { color: var(--good); }
.log-death  { color: var(--bad); }
.log-system { color: var(--muted); -unity-font-style: italic; }

/* ── Command panel (bottom right) ───────────────────────────────────────── */

.bottom-hud {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 252px;
    padding: 8px 10px 6px 10px;
    background-color: rgba(12, 10, 10, 0.96);
    border-width: 2px;
    border-color: var(--torch);
}

.command-title {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    margin: 0 0 6px 2px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--torch);
}

.bottom-message-zone {
    position: absolute;
    bottom: 160px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.battle-message {
    margin-bottom: 8px;
    padding: 5px 18px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: var(--parchment);
    background-color: rgba(12, 10, 10, 0.95);
    border-width: 1px;
    border-color: var(--line);
}

.action-zone {
    flex-shrink: 0;
}

.target-panel-zone {
    flex-shrink: 0;
}

.target-panel-zone .menu-button {
    margin: 0 0 4px 0;
    min-width: 0;
    height: 30px;
    -unity-text-align: middle-left;
}

.action-btn {
    height: 34px;
    margin: 0 0 4px 0;
    padding: 0 8px;
    flex-direction: row;
    align-items: center;
    background-color: var(--stone-1);
    border-width: 2px;
    border-color: var(--line);
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}

.action-btn:hover {
    background-color: var(--stone-3);
    border-color: var(--torch);
}

.action-btn:active {
    background-color: var(--stone-0);
    translate: 0 1px;
}

.action-btn:disabled {
    opacity: 0.35;
}

.action-btn--primary {
    background-color: rgb(224, 178, 86);
    border-color: rgb(224, 178, 86);
}

.action-btn--primary:hover {
    background-color: rgb(240, 200, 118);
    border-color: rgb(240, 200, 118);
}

.action-btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.action-btn-label {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--parchment);
}

.action-btn-sub {
    font-size: 15px;
    color: var(--muted);
}

.action-btn-chevron {
    margin-left: 6px;
    font-size: 16px;
    color: var(--muted);
}

.action-btn--primary .action-btn-label,
.action-btn--primary .action-btn-sub {
    color: var(--stone-0);
}

/* ── Overlays (rewards / events / summary) ──────────────────────────────── */

.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 4, 6, 0.93);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.overlay-panel--shown {
    opacity: 1;
}

.overlay-card,
.intermission-layout {
    align-items: center;
    padding: 22px 30px;
    background-color: var(--stone-1);
    border-radius: 6px;
    border-width: 3px;
    border-color: var(--line);
}

.intermission-layout {
    max-width: 95%;
}

.overlay-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--torch);
    letter-spacing: 2px;
}

.overlay-subtitle {
    margin-top: 4px;
    font-size: 16px;
    color: var(--gold);
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlay-instruction {
    margin-top: 10px;
    margin-bottom: 8px;
    font-size: 15px;
    color: var(--muted);
}

.upgrade-choices {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
}

.reroll-container {
    margin-top: 10px;
    align-items: center;
}

.reroll-button {
    min-width: 150px;
}

.restart-button {
    margin-top: 16px;
    min-width: 180px;
    height: 42px;
    font-size: 16px;
}

/* ── Reward / event / room cards ────────────────────────────────────────── */

.reward-card {
    width: 214px;
    margin: 6px;
    background-color: var(--stone-2);
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--iron);
    transition-property: scale, border-color, opacity, translate;
    transition-duration: 0.18s;
}

.reward-card:hover {
    scale: 1.04 1.04;
    border-color: var(--torch);
}

.reward-card-type {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 10px;
    background-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 2px;
    border-bottom-color: var(--iron);
}

.reward-card-tag {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
}

.reward-card-type-label {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--parchment);
}

.reward-card-body {
    flex-grow: 1;
    align-items: center;
    padding: 12px 10px 6px 10px;
}

.reward-card-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 2px;
    border-color: var(--iron-dark);
}

.reward-card-icon-img {
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.reward-card-name,
.reward-card-title {
    margin-bottom: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--parchment);
}

.reward-card-desc {
    font-size: 14px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--muted);
}

.reward-card-for {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--gold);
}

.reward-button {
    height: 32px;
    margin: 8px;
    color: var(--stone-0);
    -unity-font-style: bold;
    background-color: var(--torch);
    border-width: 0;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.reward-button:hover {
    background-color: rgb(255, 190, 110);
}

.reward-button:active {
    background-color: var(--torch-dim);
}

.reward-button:disabled {
    background-color: var(--iron-dark);
    color: var(--muted);
}

.merchant-leave-btn {
    align-self: center;
    min-width: 110px;
    height: 36px;
    margin: 6px;
    -unity-font-style: bold;
    color: var(--parchment);
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--iron);
}

.merchant-leave-btn:hover {
    border-color: var(--torch);
}

/* rarity variants: coloured header line + label */
.reward-card--legendary { border-color: rgb(110, 76, 150); }
.reward-card--legendary .reward-card-type { border-bottom-color: var(--violet); }
.reward-card--legendary .reward-card-type-label { color: var(--violet); }

.reward-card--relic { border-color: rgb(140, 110, 50); }
.reward-card--relic .reward-card-type { border-bottom-color: var(--gold); }
.reward-card--relic .reward-card-type-label { color: var(--gold); }

.reward-card--curse { border-color: rgb(80, 110, 56); }
.reward-card--curse .reward-card-type { border-bottom-color: var(--curse); }
.reward-card--curse .reward-card-type-label { color: var(--curse); }

.reward-card--skill .reward-card-type { border-bottom-color: rgb(110, 160, 230); }
.reward-card--skill .reward-card-type-label { color: rgb(110, 160, 230); }

/* pick-then-confirm loot cards */
.reward-card--pick:hover { scale: 1.02 1.02; }

.reward-card--selected {
    background-color: var(--stone-3);
    border-color: var(--torch);
    border-width: 3px;
    scale: 1.04 1.04;
}

/* ── Tooltip ────────────────────────────────────────────────────────────── */

.tooltip {
    position: absolute;
    display: none;
    max-width: 260px;
    padding: 7px 10px;
    background-color: rgb(14, 11, 13);
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--torch-dim);
}

.tooltip-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--torch);
}

.tooltip-body {
    margin-top: 2px;
    font-size: 13px;
    white-space: normal;
    color: var(--parchment);
}

/* ── Merchant price + confirm ───────────────────────────────────────────── */

.reward-card-price {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
}

.reward-card-price-icon {
    width: 18px;
    height: 18px;
    margin-right: 5px;
    background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.reward-card-price-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--gold);
}

.reward-card-price-text--short {
    color: var(--bad);
}

.reward-card-need {
    margin-top: 2px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--bad);
}

.reward-button--confirm {
    background-color: var(--good);
}

/* ── Run summary ────────────────────────────────────────────────────────── */

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 380px;
    margin-top: 14px;
}

.summary-stat {
    width: 112px;
    margin: 4px;
    padding: 8px 4px;
    align-items: center;
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--iron-dark);
}

.summary-stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.summary-stat-label {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: var(--muted);
}

.summary-section-title {
    margin-top: 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--torch);
}

.summary-relics {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 380px;
    max-height: 90px;
    margin-top: 6px;
    overflow: hidden;
}

/* ── Display font (Cinzel) for headings ─────────────────────────────────── */

.overlay-title,
.reward-card-name,
.reward-card-title,
.reward-card-type-label,
.summary-stat-value,
.summary-section-title,
.tooltip-title,
.reward-card-price-text,
.menu-button,
.reward-button {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
}

/* ── Loot footer (also collected + confirm) ─────────────────────────────── */

.reroll-container {
    align-self: stretch;
    align-items: stretch;
}

.loot-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.loot-row-label {
    margin-right: 10px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
}

.loot-row-label--gap {
    margin-left: 18px;
}

.loot-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.loot-pill {
    margin: 0 6px 4px 0;
    padding: 1px 8px;
    font-size: 14px;
    color: var(--parchment);
    background-color: var(--stone-1);
    border-width: 1px;
    border-color: var(--iron);
}

.loot-pill--gold { color: var(--gold); border-color: var(--torch-dim); }
.loot-pill--foe  { color: rgb(236, 150, 140); border-color: rgb(130, 58, 52); }

.loot-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.loot-hint {
    flex-grow: 1;
    margin: 0 14px;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--muted);
}

.loot-take {
    min-width: 230px;
    height: 40px;
    margin: 0;
    padding: 0 14px;
}

/* ── Victory screen ─────────────────────────────────────────────────────── */

.victory-layout {
    align-items: center;
}

.victory-title {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: var(--torch);
}

.victory-sub {
    margin-top: 2px;
    font-size: 17px;
    letter-spacing: 3px;
    color: var(--muted);
}

.victory-card {
    width: 520px;
    margin-top: 22px;
    padding: 18px 22px;
    background-color: var(--stone-1);
    border-width: 2px;
    border-color: var(--line);
}

.victory-row {
    flex-direction: row;
    align-items: flex-start;
}

.victory-block {
    margin-right: 30px;
}

.victory-block--grow {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 0;
}

.victory-label {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--muted);
}

.victory-gold {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--torch);
}

.victory-small {
    font-size: 14px;
    color: var(--muted);
}

.victory-claim {
    height: 46px;
    margin: 20px 0 0 0;
    font-size: 17px;
    letter-spacing: 3px;
}

/* Full-screen overlays hide the in-battle HUD behind them (run info stays for gold). */
.overlay-open .stats-panel-left,
.overlay-open .battle-log,
.overlay-open .bottom-hud,
.overlay-open .bottom-message-zone,
.overlay-open .turn-order-wrap,
.overlay-open .run-rewards {
    display: none;
}
