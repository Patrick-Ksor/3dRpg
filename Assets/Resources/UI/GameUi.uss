/* ═══════════════════════════════════════════════════════════════════════
   Battle UI — dungeon theme: dark stone, iron borders, torch-orange accents.
   All colours live in the variables below; change them here only.
   Layout uses margins (not gap) so it works on every UI Toolkit version.
   ═══════════════════════════════════════════════════════════════════════ */

:root {
    --stone-0: rgb(16, 13, 15);
    --stone-1: rgb(27, 23, 26);
    --stone-2: rgb(42, 36, 40);
    --stone-3: rgb(60, 53, 58);
    --iron: rgb(96, 88, 94);
    --iron-dark: rgb(52, 47, 52);
    --iron-light: rgb(138, 128, 134);

    --torch: rgb(255, 160, 70);
    --torch-dim: rgb(178, 100, 36);
    --parchment: rgb(236, 224, 200);
    --muted: rgb(160, 150, 142);

    --hp: rgb(190, 48, 48);
    --mp: rgb(70, 110, 215);
    --gold: rgb(242, 192, 72);
    --good: rgb(110, 200, 120);
    --bad: rgb(230, 90, 80);

    --violet: rgb(160, 100, 220);
    --curse: rgb(120, 170, 80);
}

.battle-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--parchment);
}

/* ── Shared building blocks ─────────────────────────────────────────────── */

.anim-hidden {
    opacity: 0;
    translate: 0 26px;
}

.menu-button {
    min-width: 120px;
    height: 36px;
    margin: 3px;
    padding: 0 14px;
    color: var(--parchment);
    -unity-font-style: bold;
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 2px;
    border-top-color: var(--iron-light);
    border-left-color: var(--iron-light);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: var(--stone-3);
    border-top-color: var(--torch);
    border-left-color: var(--torch);
    border-bottom-color: var(--torch-dim);
    border-right-color: var(--torch-dim);
    scale: 1.04 1.04;
}

.menu-button:active {
    background-color: var(--stone-1);
    scale: 0.98 0.98;
}

.menu-button:disabled {
    opacity: 0.4;
}

/* ── Icons (set from USS so they also work in builds) ───────────────────── */

.icon-sword   { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Sword.png"); }
.icon-shield  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Shield.png"); }
.icon-energy  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Energy.png"); }
.icon-clover  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Clover.png"); }
.icon-coin    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png"); }
.icon-attack  { background-image: url("/Assets/UI/AttackButton.png"); }
.icon-special { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Energy.png"); }
.icon-defend  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/shield blue.png"); }
.icon-item    { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Bag.png"); }

/* ── Turn order (top centre) ────────────────────────────────────────────── */

.turn-order {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.turn-chip {
    width: 44px;
    height: 44px;
    margin: 0 3px;
    background-color: var(--stone-1);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--iron-dark);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0.85;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.2s;
}

.turn-chip--player { border-color: var(--good); }
.turn-chip--enemy  { border-color: var(--bad); }

.turn-chip--active {
    scale: 1.28 1.28;
    opacity: 1;
    margin: 0 9px;
    border-color: var(--torch);
}

.turn-chip--dead {
    opacity: 0.18;
}

.turn-chip-letter {
    color: var(--parchment);
    font-size: 18px;
    -unity-font-style: bold;
}

.turn-chip-hp {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background-color: rgba(0, 0, 0, 0.7);
}

.turn-chip-hp-fill {
    height: 100%;
    background-color: var(--hp);
}

.turn-divider {
    width: 2px;
    height: 30px;
    margin: 0 8px;
    background-color: var(--iron);
}

/* ── Run HUD (top left) ─────────────────────────────────────────────────── */

.run-hud {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 8px 12px;
    background-color: rgba(16, 13, 15, 0.82);
    border-radius: 4px;
    border-width: 2px;
    border-top-color: var(--iron);
    border-left-color: var(--iron);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
}

.run-hud-row {
    flex-direction: row;
    align-items: center;
}

.run-hud-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.gold-label {
    color: var(--gold);
    transition-property: scale, color;
    transition-duration: 0.18s;
    transform-origin: left center;
}

.gold-label--pulse {
    scale: 1.3 1.3;
    color: rgb(255, 230, 140);
}

.gold-icon {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.room-badge {
    display: none;
    margin-left: 8px;
    padding: 1px 7px;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 3px;
    color: var(--stone-0);
}

.room-badge--mini {
    display: flex;
    background-color: var(--torch);
}

.room-badge--boss {
    display: flex;
    background-color: var(--bad);
    color: rgb(255, 240, 230);
}

/* ── Relic / upgrade strip ──────────────────────────────────────────────── */

.run-rewards {
    position: absolute;
    top: 82px;
    left: 10px;
    max-width: 260px;
    max-height: 26%;
    flex-direction: row;
    flex-wrap: wrap;
    overflow: hidden;
}

.reward-pill {
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--parchment);
    background-color: rgba(27, 23, 26, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--iron);
}

.reward-pill--stat   { border-color: rgb(90, 150, 210); }
.reward-pill--attack { border-color: var(--torch); }
.reward-pill--trait  { border-color: var(--violet); }
.reward-pill--relic  { border-color: var(--gold); color: var(--gold); }

/* ── Hero card (left) ───────────────────────────────────────────────────── */

.stats-panel-left {
    position: absolute;
    left: 10px;
    bottom: 114px;
    width: 150px;
    padding: 6px 8px;
    background-color: rgba(16, 13, 15, 0.86);
    border-radius: 4px;
    border-width: 2px;
    border-top-color: var(--iron);
    border-left-color: var(--iron);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
}

.stats-panel-portrait {
    width: 100%;
    height: 64px;
    margin-bottom: 4px;
    background-color: var(--stone-1);
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--iron-dark);
}

.stats-panel-name {
    margin-bottom: 5px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--torch);
}

.stats-panel-hp,
.stats-panel-mp {
    height: 16px;
    margin-bottom: 4px;
}

.stats-panel-hp .unity-progress-bar__container,
.stats-panel-mp .unity-progress-bar__container {
    height: 100%;
}

.stats-panel-hp .unity-progress-bar__background,
.stats-panel-mp .unity-progress-bar__background {
    background-color: rgb(8, 6, 8);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--iron-dark);
}

.stats-panel-hp .unity-progress-bar__progress { background-color: rgb(78, 168, 96); border-radius: 2px; }
.stats-panel-mp .unity-progress-bar__progress { background-color: var(--mp); border-radius: 2px; }

.stats-panel-hp .unity-progress-bar__title,
.stats-panel-mp .unity-progress-bar__title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.stats-panel-rows {
    margin-top: 4px;
}

.stats-panel-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding: 1px 3px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.35s;
}

.stats-panel-row-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.stats-panel-row-label {
    flex-grow: 1;
    font-size: 11px;
    color: var(--muted);
}

.stats-panel-row-value {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.stats-panel-row--up   { background-color: rgba(110, 200, 120, 0.45); }
.stats-panel-row--down { background-color: rgba(230, 90, 80, 0.45); }

/* ── Battle log (right) ─────────────────────────────────────────────────── */

.battle-log {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 250px;
    background-color: rgba(16, 13, 15, 0.82);
    border-radius: 4px;
    border-width: 2px;
    border-top-color: var(--iron);
    border-left-color: var(--iron);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
}

.battle-log-header {
    padding: 4px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--torch);
    background-color: var(--stone-2);
}

.battle-log-header:hover {
    background-color: var(--stone-3);
}

.battle-log-scroll {
    max-height: 92px;
}

.battle-log-content {
    padding: 4px 8px;
}

.battle-log-entry {
    margin-bottom: 2px;
    font-size: 12px;
    white-space: normal;
    color: var(--parchment);
}

.log-crit   { color: var(--torch); -unity-font-style: bold; }
.log-heal   { color: var(--good); }
.log-death  { color: var(--bad); }
.log-system { color: var(--muted); -unity-font-style: italic; }

/* ── Bottom HUD ─────────────────────────────────────────────────────────── */

.bottom-hud {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 104px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background-color: rgba(16, 13, 15, 0.9);
    border-top-width: 3px;
    border-top-color: var(--iron-dark);
}

.bottom-message-zone {
    position: absolute;
    bottom: 104px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.battle-message {
    margin-bottom: 8px;
    padding: 5px 16px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--parchment);
    background-color: rgba(16, 13, 15, 0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--iron);
}

.action-zone {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.target-panel-zone {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    padding: 0 8px;
    flex-shrink: 0;
}

.action-btn {
    width: 84px;
    height: 84px;
    margin: 0 4px;
    padding: 6px 4px;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    background-color: var(--stone-2);
    border-radius: 5px;
    border-width: 2px;
    border-top-color: var(--iron-light);
    border-left-color: var(--iron-light);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.12s;
}

.action-btn:hover {
    background-color: var(--stone-3);
    border-top-color: var(--torch);
    border-left-color: var(--torch);
    border-bottom-color: var(--torch-dim);
    border-right-color: var(--torch-dim);
    translate: 0 -3px;
}

.action-btn:active {
    background-color: var(--stone-1);
    translate: 0 1px;
}

.action-btn:disabled {
    opacity: 0.35;
}

.action-btn-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.action-btn-label {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--torch);
}

/* ── Overlays (rewards / events / summary) ──────────────────────────────── */

.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 4, 6, 0.8);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.overlay-panel--shown {
    opacity: 1;
}

.overlay-card,
.intermission-layout {
    align-items: center;
    padding: 22px 30px;
    background-color: var(--stone-1);
    border-radius: 6px;
    border-width: 3px;
    border-top-color: var(--iron-light);
    border-left-color: var(--iron-light);
    border-bottom-color: var(--iron-dark);
    border-right-color: var(--iron-dark);
}

.intermission-layout {
    max-width: 95%;
}

.overlay-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--torch);
    letter-spacing: 2px;
}

.overlay-subtitle {
    margin-top: 4px;
    font-size: 16px;
    color: var(--gold);
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlay-instruction {
    margin-top: 10px;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted);
}

.upgrade-choices {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
}

.reroll-container {
    margin-top: 10px;
    align-items: center;
}

.reroll-button {
    min-width: 150px;
}

.restart-button {
    margin-top: 16px;
    min-width: 180px;
    height: 42px;
    font-size: 16px;
}

/* ── Reward / event / room cards ────────────────────────────────────────── */

.reward-card {
    width: 190px;
    margin: 6px;
    background-color: var(--stone-2);
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--iron);
    transition-property: scale, border-color, opacity, translate;
    transition-duration: 0.18s;
}

.reward-card:hover {
    scale: 1.04 1.04;
    border-color: var(--torch);
}

.reward-card-type {
    padding: 4px 0;
    background-color: var(--iron-dark);
    align-items: center;
}

.reward-card-type-label {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--parchment);
}

.reward-card-body {
    flex-grow: 1;
    align-items: center;
    padding: 12px 10px 6px 10px;
}

.reward-card-icon {
    width: 54px;
    height: 54px;
    margin-bottom: 8px;
}

.reward-card-name,
.reward-card-title {
    margin-bottom: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--parchment);
}

.reward-card-desc {
    font-size: 12px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--muted);
}

.reward-card-for {
    margin-top: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--gold);
}

.reward-button {
    height: 32px;
    margin: 8px;
    color: var(--stone-0);
    -unity-font-style: bold;
    background-color: var(--torch);
    border-width: 0;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.reward-button:hover {
    background-color: rgb(255, 190, 110);
}

.reward-button:active {
    background-color: var(--torch-dim);
}

.reward-button:disabled {
    background-color: var(--iron-dark);
    color: var(--muted);
}

.merchant-leave-btn {
    align-self: center;
    min-width: 110px;
    height: 36px;
    margin: 6px;
    -unity-font-style: bold;
    color: var(--parchment);
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--iron);
}

.merchant-leave-btn:hover {
    border-color: var(--torch);
}

/* rarity variants */
.reward-card--legendary { border-color: var(--violet); }
.reward-card--legendary .reward-card-type { background-color: rgb(84, 48, 120); }

.reward-card--relic { border-color: var(--gold); }
.reward-card--relic .reward-card-type { background-color: rgb(130, 96, 24); }

.reward-card--curse { border-color: var(--curse); }
.reward-card--curse .reward-card-type { background-color: rgb(52, 84, 32); }

/* ── Tooltip ────────────────────────────────────────────────────────────── */

.tooltip {
    position: absolute;
    display: none;
    max-width: 260px;
    padding: 7px 10px;
    background-color: rgb(14, 11, 13);
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--torch-dim);
}

.tooltip-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--torch);
}

.tooltip-body {
    margin-top: 2px;
    font-size: 11px;
    white-space: normal;
    color: var(--parchment);
}

/* ── Merchant price + confirm ───────────────────────────────────────────── */

.reward-card-price {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
}

.reward-card-price-icon {
    width: 18px;
    height: 18px;
    margin-right: 5px;
    background-image: url("/Assets/Violet Theme Ui/Colored Icons/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.reward-card-price-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--gold);
}

.reward-card-price-text--short {
    color: var(--bad);
}

.reward-card-need {
    margin-top: 2px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--bad);
}

.reward-button--confirm {
    background-color: var(--good);
}

/* ── Run summary ────────────────────────────────────────────────────────── */

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 380px;
    margin-top: 14px;
}

.summary-stat {
    width: 112px;
    margin: 4px;
    padding: 8px 4px;
    align-items: center;
    background-color: var(--stone-2);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--iron-dark);
}

.summary-stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.summary-stat-label {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: var(--muted);
}

.summary-section-title {
    margin-top: 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--torch);
}

.summary-relics {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 380px;
    max-height: 90px;
    margin-top: 6px;
    overflow: hidden;
}
