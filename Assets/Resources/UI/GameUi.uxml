<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="GameUi.uss" />

    <ui:VisualElement name="battle-root" class="battle-root">

        <!-- World-following nameplates (filled by Nameplates.cs) -->
        <ui:VisualElement name="nameplate-layer" class="nameplate-layer" picking-mode="Ignore"/>

        <!-- Top centre: turn order -->
        <ui:VisualElement class="turn-order-wrap" picking-mode="Ignore">
            <ui:VisualElement class="turn-order-panel">
                <ui:Label text="TURN ORDER" class="turn-order-title"/>
                <ui:VisualElement name="turn-order" class="turn-order"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top left: run info -->
        <ui:VisualElement name="run-hud" class="run-hud">
            <ui:VisualElement class="run-hud-row">
                <ui:Label name="encounter-label" text="Encounter 1" class="run-hud-label run-hud-title"/>
                <ui:Label name="room-badge" text="" class="room-badge"/>
            </ui:VisualElement>
            <ui:VisualElement class="run-hud-row">
                <ui:VisualElement name="gold-icon" class="gold-icon"/>
                <ui:Label name="gold-label" text="0 Gold" class="run-hud-label gold-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="run-rewards" class="run-rewards"/>

        <!-- Bottom left: hero card -->
        <ui:VisualElement name="stats-panel-left" class="stats-panel-left">
            <ui:VisualElement class="stats-panel-head">
                <ui:VisualElement name="stats-panel-portrait" class="stats-panel-portrait"/>
                <ui:VisualElement class="stats-panel-info">
                    <ui:Label name="stats-panel-name" class="stats-panel-name" text=""/>
                    <ui:ProgressBar name="stats-panel-hp" class="stats-panel-hp"/>
                    <ui:ProgressBar name="stats-panel-mp" class="stats-panel-mp" style="display: none;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="stats-panel-rows" class="stats-panel-rows"/>
        </ui:VisualElement>

        <!-- Bottom centre: battle log -->
        <ui:VisualElement name="battle-log" class="battle-log">
            <ui:VisualElement class="battle-log-head">
                <ui:Label name="battle-log-header" text="COMBAT LOG" class="battle-log-header"/>
                <ui:Button name="claim-btn" text="CLAIM SPOILS" class="claim-btn"/>
            </ui:VisualElement>
            <ui:ScrollView name="battle-log-scroll" class="battle-log-scroll">
                <ui:VisualElement name="battle-log-content" class="battle-log-content"/>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Bottom right: commands -->
        <ui:VisualElement name="bottom-hud" class="bottom-hud">
            <ui:VisualElement class="command-head">
                <ui:Label name="command-title" text="COMMANDS" class="command-title"/>
                <ui:Label name="command-round" text="" class="command-round"/>
            </ui:VisualElement>
            <ui:VisualElement name="action-zone" class="action-zone">
                <ui:Button name="attack-btn" class="action-btn">
                    <ui:VisualElement name="attack-btn-icon" class="action-btn-icon icon-attack"/>
                    <ui:Label text="ATTACK" class="action-btn-label"/>
                    <ui:Label name="attack-btn-sub" text="" class="action-btn-sub"/>
                </ui:Button>
                <ui:Button name="special-btn" class="action-btn">
                    <ui:VisualElement name="special-btn-icon" class="action-btn-icon icon-special"/>
                    <ui:Label text="SPECIAL" class="action-btn-label"/>
                    <ui:Label name="special-btn-sub" text="" class="action-btn-sub"/>
                    <ui:Label text="&gt;" class="action-btn-chevron"/>
                </ui:Button>
                <ui:Button name="item-btn" class="action-btn">
                    <ui:VisualElement name="item-btn-icon" class="action-btn-icon icon-item"/>
                    <ui:Label text="ITEM" class="action-btn-label"/>
                    <ui:Label name="item-btn-sub" text="" class="action-btn-sub"/>
                    <ui:Label text="&gt;" class="action-btn-chevron"/>
                </ui:Button>
                <ui:Button name="defend-btn" class="action-btn">
                    <ui:VisualElement name="defend-btn-icon" class="action-btn-icon icon-defend"/>
                    <ui:Label text="DEFEND" class="action-btn-label"/>
                    <ui:Label name="defend-btn-sub" text="Half damage" class="action-btn-sub"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="target-panel-zone" class="target-panel-zone" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-message-zone" class="bottom-message-zone">
            <ui:Label name="battle-message" text="" class="battle-message" style="display: none;"/>
            <ui:Label name="tip-label" text="" class="tip-label"/>
        </ui:VisualElement>

        <!-- Overlays -->
        <ui:VisualElement name="intermission-panel" class="overlay-panel">
            <ui:VisualElement class="intermission-layout">
                <ui:Label name="intermission-title" text="Victory!" class="overlay-title"/>
                <ui:Label name="intermission-gold" text="+0 Gold" class="overlay-subtitle"/>
                <ui:Label name="intermission-instruction" text="Choose an upgrade:" class="overlay-instruction"/>
                <ui:VisualElement name="upgrade-choices" class="upgrade-choices"/>
                <ui:VisualElement name="reroll-container" class="reroll-container"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="run-summary-panel" class="overlay-panel">
            <ui:VisualElement class="overlay-card">
                <ui:Label name="summary-title" text="Run Complete!" class="overlay-title"/>
                <ui:Label name="summary-stats" text="" class="overlay-subtitle"/>
                <ui:VisualElement name="summary-grid" class="summary-grid"/>
                <ui:Label name="summary-relics-title" text="RELICS &amp; UPGRADES" class="summary-section-title"/>
                <ui:VisualElement name="summary-relics" class="summary-relics"/>
                <ui:Button name="summary-restart" text="New Run" class="menu-button restart-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Tooltip (positioned by code) -->
        <ui:VisualElement name="tooltip" class="tooltip">
            <ui:Label name="tooltip-title" class="tooltip-title"/>
            <ui:Label name="tooltip-body" class="tooltip-body"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
