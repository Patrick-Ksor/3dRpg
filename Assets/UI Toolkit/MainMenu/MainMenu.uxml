<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="MainMenuStyles.uss" />

    <ui:VisualElement class="main-container">

        <ui:VisualElement class="title-block">
            <ui:Label text="CHOOSE YOUR HERO" class="main-title" />
            <ui:Label text="DESCEND. FIGHT. GROW STRONGER. SURVIVE." class="main-subtitle" />
        </ui:VisualElement>

        <ui:VisualElement name="hero-list" class="hero-list" />

        <ui:VisualElement name="character-card" class="character-card">
            <ui:VisualElement name="character-preview" class="character-preview" />
            <ui:Label name="character-name" text="Hero Name" class="character-name" />
            <ui:Label name="character-role" text="" class="character-role" />
            <ui:Label name="character-desc" text="Hero description goes here..." class="character-desc" />
        </ui:VisualElement>

        <ui:VisualElement name="details-panel" class="details-panel">
            <ui:Label text="STATS" class="section-title" />
            <ui:VisualElement name="stat-bars" class="stat-bars" />
            <ui:VisualElement class="divider" />
            <ui:Label text="STARTING SKILL" class="section-title" />
            <ui:VisualElement name="skill-list" class="skill-list" />
        </ui:VisualElement>

        <ui:VisualElement class="footer">
            <ui:Button name="start-btn" text="BEGIN DESCENT  &gt;" class="start-btn" />
            <ui:Button name="quit-btn" text="QUIT" class="quit-btn" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
