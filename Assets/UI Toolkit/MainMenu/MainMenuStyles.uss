/* Main menu — same dungeon palette as Resources/UI/GameUi.uss (keep the variables in sync). */

:root {
    --stone-0: rgb(14, 12, 12);
    --stone-1: rgb(22, 17, 14);
    --stone-2: rgb(36, 29, 23);
    --stone-3: rgb(54, 43, 32);
    --iron: rgb(92, 74, 54);
    --iron-dark: rgb(58, 46, 34);
    --iron-light: rgb(120, 98, 70);
    --line: rgb(74, 59, 44);
    --torch: rgb(224, 178, 86);
    --torch-dim: rgb(150, 115, 52);
    --parchment: rgb(238, 228, 208);
    --muted: rgb(166, 154, 138);
    --hp: rgb(78, 168, 96);
    --mp: rgb(70, 110, 215);
}

.main-container {
    -unity-font-definition: url("/Assets/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    flex-grow: 1;
    background-color: var(--stone-0);
    padding: 20px 36px 24px 36px;
    color: var(--parchment);
}

/* ── Title ──────────────────────────────────────────────────────────────── */

.title-block {
    flex-shrink: 0;
}

.main-title {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--torch);
}

.main-subtitle {
    margin-top: 2px;
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--muted);
}

/* ── Three columns: hero list | preview | details ───────────────────────── */

.selection-area {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0;
    min-height: 0;
}

.hero-list {
    width: 270px;
    flex-shrink: 0;
}

.hero-entry {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 5px 10px;
    background-color: var(--stone-1);
    border-width: 2px;
    border-color: var(--line);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.hero-entry:hover {
    background-color: var(--stone-2);
    border-color: var(--iron-light);
}

.hero-entry--selected {
    background-color: rgb(58, 44, 24);
    border-color: var(--torch);
}

.hero-entry-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: var(--stone-0);
    border-width: 2px;
    border-color: var(--iron-dark);
    -unity-background-scale-mode: scale-to-fit;
}

.hero-entry--selected .hero-entry-icon {
    border-color: var(--torch-dim);
}

.hero-entry-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.hero-entry-sub {
    font-size: 14px;
    color: var(--muted);
}

/* centre: big preview */

.character-card {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.14s;
}

.character-preview {
    width: 170px;
    height: 170px;
    margin-bottom: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 85px;
    border-width: 2px;
    border-color: var(--iron-dark);
    -unity-background-scale-mode: scale-to-fit;
}

.character-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    margin-bottom: 6px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--parchment);
}

.character-desc {
    max-width: 320px;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--muted);
}

.swapping {
    opacity: 0;
    translate: 0 10px;
}

/* right: details */

.details-panel {
    width: 330px;
    flex-shrink: 0;
    padding: 10px 16px;
    background-color: var(--stone-1);
    border-width: 2px;
    border-color: var(--line);
    transition-property: opacity, translate;
    transition-duration: 0.14s;
}

.details-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    margin-bottom: 4px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.section-title {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--muted);
}

.section-title--spaced {
    margin-top: 8px;
}

.stat-bars {
    flex-shrink: 0;
    margin-top: 6px;
}

.stat-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
}

.stat-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-name {
    width: 40px;
    font-size: 14px;
    color: var(--muted);
}

.stat-track {
    flex-grow: 1;
    height: 8px;
    margin: 0 8px;
    background-color: rgb(34, 27, 21);
}

.stat-fill {
    height: 100%;
    width: 0;
    background-color: var(--torch);
    transition-property: width;
    transition-duration: 0.35s;
}

.stat-fill--hp { background-color: rgb(212, 82, 74); }
.stat-fill--mp { background-color: rgb(91, 141, 214); }

.stat-value {
    width: 34px;
    font-size: 16px;
    -unity-text-align: middle-right;
    color: var(--parchment);
}

.icon-heart  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Heart.png"); }
.icon-star   { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Star.png"); }
.icon-sword  { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Sword.png"); }
.icon-shield { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Shield.png"); }
.icon-energy { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Energy.png"); }
.icon-clover { background-image: url("/Assets/Violet Theme Ui/Colored Icons/Clover.png"); }

.skill-list {
    flex-shrink: 0;
    margin-top: 6px;
}

.skill {
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 4px 10px;
    background-color: var(--stone-2);
    border-left-width: 3px;
    border-left-color: var(--torch-dim);
}

.skill-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.skill-desc {
    flex-shrink: 0;
    margin-top: 1px;
    font-size: 14px;
    white-space: normal;
    color: var(--muted);
}

.skill-note {
    font-size: 14px;
    -unity-font-style: italic;
    white-space: normal;
    color: var(--muted);
}

/* ── Footer buttons ─────────────────────────────────────────────────────── */

.footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.start-btn {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    width: 300px;
    height: 54px;
    margin-right: 14px;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--stone-0);
    background-color: var(--torch);
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.start-btn:hover {
    background-color: rgb(240, 200, 118);
    scale: 1.03 1.03;
}

.start-btn:active {
    background-color: var(--torch-dim);
    scale: 0.98 0.98;
}

.quit-btn {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    width: 100px;
    height: 54px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--parchment);
    background-color: var(--stone-1);
    border-width: 2px;
    border-color: var(--line);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.quit-btn:hover {
    background-color: var(--stone-2);
    border-color: var(--torch);
}
