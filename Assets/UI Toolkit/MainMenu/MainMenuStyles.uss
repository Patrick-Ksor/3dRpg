/* Main menu — same dungeon palette as Resources/UI/GameUi.uss (keep the variables in sync). */

:root {
    --stone-0: rgb(14, 12, 12);
    --stone-1: rgb(22, 17, 14);
    --stone-2: rgb(36, 29, 23);
    --stone-3: rgb(54, 43, 32);
    --iron: rgb(92, 74, 54);
    --iron-dark: rgb(58, 46, 34);
    --iron-light: rgb(120, 98, 70);
    --line: rgb(61, 50, 40);
    --torch: rgb(224, 178, 86);
    --torch-dim: rgb(150, 115, 52);
    --parchment: rgb(238, 228, 208);
    --muted: rgb(166, 154, 138);
    --hp: rgb(78, 168, 96);
    --mp: rgb(70, 110, 215);
}

.main-container {
    -unity-font-definition: url("/Assets/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 20px;
    flex-grow: 1;
    background-color: rgb(15, 13, 12);
    color: var(--parchment);
}

/* ── Title ──────────────────────────────────────────────────────────────── */

.title-block {
    position: absolute;
    left: 40px;
    top: 34px;
}

.main-title {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--torch);
}

.main-subtitle {
    margin-top: 8px;
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--muted);
}

/* ── Hero list (left) ───────────────────────────────────────────────────── */

.hero-list {
    position: absolute;
    left: 40px;
    top: 150px;
    width: 300px;
}

.hero-entry {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin-bottom: 8px;
    padding: 0 14px;
    background-color: rgba(18, 14, 12, 0.86);
    border-width: 2px;
    border-color: var(--line);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.hero-entry:hover {
    background-color: rgba(34, 27, 22, 0.95);
    border-color: var(--iron);
}

.hero-entry--selected {
    background-color: rgba(58, 44, 28, 0.92);
    border-color: var(--torch);
}

.hero-entry-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    margin-right: 14px;
    background-color: rgba(94, 102, 112, 0.12);
    border-width: 2px;
    border-color: rgb(94, 102, 112);
    -unity-background-scale-mode: scale-to-fit;
}

.hero-entry--selected .hero-entry-icon { border-color: var(--torch); }

.hero-entry-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.hero-entry-sub {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--muted);
}

/* ── Centre: portrait + description ─────────────────────────────────────── */

.character-card {
    position: absolute;
    left: 380px;
    top: 150px;
    width: 500px;
    align-items: center;
    transition-property: opacity, translate;
    transition-duration: 0.14s;
}

.character-preview {
    width: 240px;
    height: 240px;
    margin-bottom: 14px;
    background-color: rgba(94, 102, 112, 0.12);
    border-radius: 120px;
    border-width: 3px;
    border-color: var(--torch);
    -unity-background-scale-mode: scale-to-fit;
}

.character-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 30px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--parchment);
}

.character-role {
    margin-top: 4px;
    margin-bottom: 14px;
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--torch);
}

.character-desc {
    max-width: 400px;
    font-size: 20px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgb(217, 205, 185);
}

.swapping {
    opacity: 0;
    translate: 0 10px;
}

/* ── Right: stats + starting skill ──────────────────────────────────────── */

.details-panel {
    position: absolute;
    right: 40px;
    top: 150px;
    width: 340px;
    padding: 16px 22px;
    background-color: rgba(18, 14, 12, 0.92);
    border-width: 2px;
    border-color: var(--iron);
    transition-property: opacity, translate;
    transition-duration: 0.14s;
}

.section-title {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--muted);
}

.divider {
    height: 1px;
    margin: 10px 0;
    background-color: var(--line);
}

.stat-bars {
    flex-shrink: 0;
    margin-top: 10px;
}

.stat-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.stat-dot {
    width: 10px;
    height: 10px;
    margin-right: 12px;
}

.stat-name {
    width: 36px;
    margin-right: 10px;
    font-size: 17px;
    letter-spacing: 1px;
    color: var(--muted);
}

.stat-track {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(46, 39, 34);
}

.stat-fill {
    height: 100%;
    width: 0;
    background-color: var(--torch);
    transition-property: width;
    transition-duration: 0.35s;
}

.stat-value {
    width: 36px;
    margin-left: 10px;
    font-size: 17px;
    -unity-text-align: middle-right;
    color: var(--parchment);
}

.skill-list {
    flex-shrink: 0;
    margin-top: 10px;
}

.skill {
    flex-shrink: 0;
    padding: 8px 14px;
    background-color: rgb(31, 25, 21);
    border-width: 1px;
    border-color: var(--line);
}

.skill-name {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--parchment);
}

.skill-desc {
    flex-shrink: 0;
    margin-top: 4px;
    font-size: 16px;
    white-space: normal;
    color: rgb(217, 205, 185);
}

.skill-note-row {
    flex-direction: column;
    margin-top: 8px;
}

.skill-note {
    font-size: 16px;
    white-space: normal;
    color: var(--muted);
}

.skill-note--learn {
    color: rgb(169, 194, 238);
}

/* ── Footer buttons ─────────────────────────────────────────────────────── */

.footer {
    position: absolute;
    left: 0;
    right: 0;
    top: 604px;
    flex-direction: row;
    justify-content: center;
}

.start-btn {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    width: 300px;
    height: 56px;
    margin: 0 16px 0 0;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(27, 20, 12);
    background-color: var(--torch);
    border-width: 2px;
    border-color: rgb(243, 208, 138);
    border-radius: 0;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.start-btn:hover { background-color: rgb(240, 200, 118); }
.start-btn:active { background-color: var(--torch-dim); }

.quit-btn {
    -unity-font-definition: url("/Assets/Fonts/Cinzel.ttf");
    width: 120px;
    height: 56px;
    margin: 0;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--parchment);
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--iron);
    border-radius: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.quit-btn:hover {
    background-color: rgba(34, 27, 22, 0.95);
    border-color: var(--torch);
}
